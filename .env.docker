# Environment variables for Docker Compose
# Copy this file to .env and fill in your values

# Redmine Configuration
REDMINE_BASE_URL=https://techsupport.6dtech.co.in
REDMINE_API_KEY=your-redmine-api-key-here
DEVOPS_PROJECT_ID=1
DEVOPS_TEAM_GROUP_ID=6

# LLM Configuration (vLLM server on this machine)
LLM_BASE_URL=http://10.0.6.31:8000/v1
LLM_MODEL=qwen2.5-coder-32b

# Google Chat Webhook
GOOGLE_CHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/your-webhook-here

# Slack (optional)
