# Application
APP_NAME=DevOps Ticket Management System
APP_VERSION=3.0.0
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=your-secret-key-change-this

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/devops_tickets
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Redmine
REDMINE_BASE_URL=https://techsupport.6dtech.co.in
REDMINE_API_KEY=your-redmine-api-key
DEVOPS_PROJECT_ID=1
DEVOPS_TEAM_GROUP_ID=6

# LLM Configuration
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=your-model-name
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Google Chat
GOOGLE_CHAT_WEBHOOK=your-webhook-url
GOOGLE_CHAT_ENABLED=True

# Slack (Optional)
SLACK_WEBHOOK=
SLACK_ENABLED=False

# Scheduler
TICKET_PROCESSING_INTERVAL=2  # minutes
SLA_CHECK_INTERVAL=1  # minutes
ANALYTICS_UPDATE_INTERVAL=60  # minutes

# ML Models
ML_MODELS_PATH=./models
ML_TRAINING_ENABLED=True
ML_MIN_TRAINING_SAMPLES=100

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# Monitoring
PROMETHEUS_ENABLED=True
SENTRY_DSN=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
