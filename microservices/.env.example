# =============================================================================
# Microservices Environment Configuration
# Copy this file to .env and replace all placeholder values with actual credentials
# =============================================================================

# Application Settings
APP_NAME=DevOps Ticket Management System
APP_VERSION=3.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Security Keys
# CRITICAL: Generate new secure random keys for production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-secret-key-here-change-this
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_USER=devops_user
POSTGRES_PASSWORD=your-strong-postgres-password-here
POSTGRES_DB=devops_tickets
DATABASE_URL=postgresql://devops_user:your-strong-postgres-password-here@postgres:5432/devops_tickets
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Redmine Configuration
REDMINE_BASE_URL=https://your-redmine-instance.com
REDMINE_API_KEY=your-redmine-api-key-here
DEVOPS_PROJECT_ID=1
DEVOPS_TEAM_GROUP_ID=6

# LLM Configuration
LLM_ENABLED=true
LLM_BASE_URL=http://your-llm-server:8000/v1
LLM_MODEL=qwen2.5-coder-32b
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Notifications
GOOGLE_CHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/YOUR_SPACE/messages?key=YOUR_KEY&token=YOUR_TOKEN
GOOGLE_CHAT_ENABLED=true
SLACK_WEBHOOK=
SLACK_ENABLED=false

# Business Hours Configuration
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=18
BUSINESS_DAYS=0,1,2,3,4
TZ=Asia/Kolkata

# Scheduler Settings
ENABLE_SCHEDULER=true
TICKET_PROCESSING_INTERVAL=2
SLA_CHECK_INTERVAL=1
ANALYTICS_UPDATE_INTERVAL=60
REDMINE_STATUS_SYNC_INTERVAL=5

# ML Configuration
ML_MODELS_PATH=./models
ML_TRAINING_ENABLED=true
ML_MIN_TRAINING_SAMPLES=50

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://your-server-ip:3000,https://your-domain.com
CORS_ALLOW_CREDENTIALS=true

# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_DSN=

# Public API URL (for callbacks, webhooks)
PUBLIC_API_BASE_URL=https://your-domain.com

# Service Ports (for reference)
AUTH_SERVICE_PORT=8001
TICKET_SERVICE_PORT=8002
TEAM_SERVICE_PORT=8003
SLA_SERVICE_PORT=8004
WORKLOAD_SERVICE_PORT=8005
ANALYTICS_SERVICE_PORT=8006
ESCALATION_SERVICE_PORT=8007
COLLABORATION_SERVICE_PORT=8008
INTEGRATION_SERVICE_PORT=8009
SCHEDULING_SERVICE_PORT=8010
WORKSESSION_SERVICE_PORT=8011

# Kong API Gateway Configuration
KONG_PG_PASSWORD=your-strong-kong-password-here
KONG_ADMIN_URL=http://localhost:8444
KONG_PROXY_URL=http://localhost:8000

# RabbitMQ Configuration
RABBITMQ_USER=devops_user
RABBITMQ_PASSWORD=your-strong-rabbitmq-password-here
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
