# Redmine Configuration
REDMINE_BASE_URL=https://your-redmine-url.com
REDMINE_API_KEY=your_redmine_api_key_here
DEVOPS_PROJECT_ID=1
DEVOPS_TEAM_GROUP_ID=6

# LLM Configuration (Optional - for AI features)
LLM_BASE_URL=http://your-llm-server:8000/v1
LLM_MODEL=qwen2.5-coder-32b

# Google Chat Webhook (Optional - for notifications)
GOOGLE_CHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/xxx/messages?key=xxx

# Timezone Configuration
# Set to your local timezone (e.g., Asia/Kolkata, America/New_York, Europe/London)
# Default is UTC if not set
TZ=UTC

# Example timezone values:
# TZ=Asia/Kolkata        # India
# TZ=America/New_York    # US Eastern
# TZ=Europe/London       # UK
# TZ=Asia/Tokyo          # Japan
# TZ=Australia/Sydney    # Australia
